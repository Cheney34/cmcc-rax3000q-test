# ============================================================================
# 轨道 B 种子配置（可选实验）：ImmortalWrt 21.02 / QSDK 5.4 / ipq50xx + 完整 NSS
#
# 说明：这条轨道跑的是 kkstone/immortalwrt-ipq50xx 的 openwrt-21.02 分支，
#       目标 target/linux/ipq50xx 的 DEFAULT_PACKAGES 里**已经包含** NSS 三件套：
#           kmod-qca-nss-dp  swconfig  kmod-qca-nss-drv  qca-nss-fw-ipq50xx-retail
#       所以这里重复列出来只是为了让工作流的「必须选中」校验有据可依。
#
# 代价（重要）：
#   - 内核是 QSDK 5.4（linux-5.4-qsdk-11.5.0.5），不是官方主线内核；
#   - 21.02 已停止维护，装不了官方 OpenWrt 的包（只有 ImmortalWrt 21.02 的 .ipk / opkg）；
#   - 千兆以内的线路**不需要**这条轨道（官方主线的软件转发足够），见 docs/路线对比与选型.md。
#
# 注意：这条轨道**允许**写 CONFIG_PACKAGE_kmod-*（我们要的就是内核模块），
#       代价是产物与官方 kmod 不通用 —— 这正是它与轨道 A 二选一的原因。
# ============================================================================

# --------------------------------------------------------- NSS（这条轨道的全部意义）
CONFIG_PACKAGE_kmod-qca-nss-dp=y
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_qca-nss-fw-ipq50xx-retail=y
# 连接管理器：把 NAT/conntrack 卸载到 NSS 核（QSDK 树里包名可能是 kmod-qca-nss-ecm）
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
# 可选：客户端卸载插件（PPPoE / VLAN / 桥接加速），需要再加
# CONFIG_PACKAGE_kmod-qca-nss-clients=y

# ------------------------------------------------------------------ 无线
# 该 target 默认已带 kmod-ath11k + wpad-basic-wolfssl，这里不重复
CONFIG_PACKAGE_wpad-basic-wolfssl=y

# -------------------------------------------------------------------- 基础
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y

# -------------------------------------------------------------- LuCI 中文
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ppp-zh-cn=y

# --------------------------------------------------------- Portal 网页认证
# 21.02 时代的 openNDS（routing feed）同样是 nftables/iptables 自适应，自带 MHD 网页服务
CONFIG_PACKAGE_opennds=y
CONFIG_PACKAGE_libmicrohttpd-no-ssl=y
CONFIG_PACKAGE_dnsmasq-full=y

# ------------------------------------------------------------ IPv6 / 工具
CONFIG_PACKAGE_iputils-ping=y
CONFIG_PACKAGE_iputils-traceroute6=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ethtool=y
